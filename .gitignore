__pycache__/
*.pyc
.venv/
venv/
.env
.DS_Store

# Data — never commit raw/interim pulls, only checked-in reference/small processed files as decided later
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep

# outputs/models/*.parquet ARE committed (decided 2026-09-01): these are
# small (~100KB total) precomputed results, not raw/redistributable-
# sensitive source data, and the app is designed to only ever read
# precomputed outputs, never recompute on page load -- so a deployed
# instance (Streamlit Community Cloud) has no way to produce them itself,
# since it never has the raw CDC WONDER exports (data/raw/* stays
# gitignored above). Re-running scripts/run_covid_disruption_pipeline.py
# locally overwrites these with fresh output as usual.

.streamlit/secrets.toml
.pytest_cache/
.ipynb_checkpoints/
